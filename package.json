{
  "name": "agentic-investigation",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "etl": "pnpm db:migrate && bun run src/modules/etl/pipeline.ts --data-dir ./data",
    "etl:senate": "pnpm db:migrate && bun run src/modules/etl/pipeline.ts --data-dir ./data --source senate",
    "etl:house": "pnpm db:migrate && bun run src/modules/etl/pipeline.ts --data-dir ./data --source house",
    "etl:press": "pnpm db:migrate && bun run src/modules/etl/pipeline.ts --data-dir ./data --source press",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@9.12.3",
  "dependencies": {
    "@t3-oss/env-nuxt": "^0.13.11",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fast-xml-parser": "^5.8.0",
    "glob": "^13.0.6",
    "pg": "^8.21.0",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.4.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
